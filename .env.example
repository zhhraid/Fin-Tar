# Salin berkas ini menjadi ".env" lalu isi nilainya. Jangan commit ".env".
# Semua baris boleh dikosongkan: FinTar tetap jalan dengan data di perangkat dan AI mode demo.

# ---------------------------------------------------------------------------
# Supabase: akun, login, dan penyimpanan data di server
# Ambil dari Supabase Dashboard > Project Settings > API.
# Kunci "anon public" memang aman berada di browser; keamanan data dijaga oleh
# Row Level Security di database (lihat supabase/migrations/).
# JANGAN isi dengan kunci "service_role".
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# AI untuk Finix (chat) dan pemindai struk. Kunci ini hanya dibaca server.
# Isi salah satu. Jika dua-duanya diisi, pilih dengan AI_PROVIDER.
# Tanpa kunci: Finix menjawab dengan rumus dari catatan transaksi dan pemindai
# struk menampilkan contoh hasil bacaan (keduanya berlabel "mode demo").
# ---------------------------------------------------------------------------
# claude atau gemini
AI_PROVIDER=

# Claude: https://platform.claude.com (berbayar per pemakaian)
ANTHROPIC_API_KEY=
# Opsional. Bawaan: claude-opus-5-5
ANTHROPIC_MODEL=

# Gemini: https://aistudio.google.com (ada kuota gratis)
GEMINI_API_KEY=
# Opsional. Bawaan: gemini-flash-latest
GEMINI_MODEL=
